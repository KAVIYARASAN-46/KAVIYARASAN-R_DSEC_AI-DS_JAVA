3.POSIOVE OR NEGATIVE 


import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int a = sc.nextInt();
        int b = sc.nextInt();
        String result1 = (a >= 0) ? "positive" : "negative";
        String result2 = (b >= 0) ? "positive" : "negative";
        System.out.println(result1);
        System.out.println(result2);

        sc.close();
    }
}



